# .env.example — compreface-core. Salin ke .env lalu isi nilai yang ditandai WAJIB. (.env tidak di-commit)
# Nama variabel sama dengan ConfigMap/Secret di k8s/base. JANGAN isi nilai asli di file ini.
ML_PORT=3000
IMG_LENGTH_LIMIT=640
# prod GPU: 4
UWSGI_PROCESSES=2
UWSGI_THREADS=1
UWSGI_MAX_WORKER_LIFETIME=93600
LOGGING_LEVEL_NAME=info
TZ=Asia/Jakarta
